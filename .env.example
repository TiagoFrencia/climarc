# ClimaRC Environment Configuration

# SMN Argentina Visitor JWT Token
# Extraído de https://www.smn.gob.ar/ (F12 -> Consola: localStorage.getItem('token'))
# Necesario para eludir el Cloudflare Managed Challenge en entornos de servidor / CI / Render
SMN_JWT_TOKEN=

# Backend Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# External API User-Agent
USER_AGENT=ClimaRC-PersonalApp/1.0

# Security & Cron Automation (Fase 5)
CRON_SECRET=climarc-local-secret-cron-key
ADMIN_PIN=

# Telegram Bot Credentials (EXCLUSIVAMENTE EN .ENV - PROHIBIDO EN FRONTEND)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FRONTEND_URL=https://climarc.vercel.app

# Umbrales de Alertas Proactivas (Persistencia ante reinicio de Render)
ALERT_RAIN_PROB_PCT=60
ALERT_RAIN_MM=1.5
ALERT_WRF_NEARBY_MM=8.0
ALERT_GUST_KMH=45.0
ALERT_TEMP_DROP_C=6.0
ALERT_COLD_APPARENT_C=5.0
ALERT_CAPE_JKG=1000.0
ALERT_COOLDOWN_HOURS=4
ALERT_QUIET_ENABLED=false
ALERT_QUIET_START_HOUR=23
ALERT_QUIET_END_HOUR=7

