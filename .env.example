# ClimaRC Environment Configuration

# SMN Argentina Visitor JWT Token
# Extraído de https://www.smn.gob.ar/ (F12 -> Consola: localStorage.getItem('token'))
# Necesario para eludir el Cloudflare Managed Challenge en entornos de servidor / CI / Render
SMN_JWT_TOKEN=

# Backend Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# External API User-Agent (Regla 4)
USER_AGENT=ClimaRC-PersonalApp/1.0
