# ==============================================================================
# ClimaRC - Configuración de Variables de Entorno (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVICIO Y BASE DE DATOS (Backend)
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info
DATABASE_PATH=data/climarc.db
# URL de conexión a PostgreSQL (Neon, Supabase Pooler IPv4). Dejar vacío "" para SQLite local
DATABASE_URL=
USER_AGENT=ClimaRC-PersonalApp/1.0

# ------------------------------------------------------------------------------
# 2. UBICACIÓN DEL PRONÓSTICO WRF-SMN (4km 3x3)
# ------------------------------------------------------------------------------
# En desarrollo local: ruta relativa al archivo generado
WRF_JSON_URL=data/wrf_latest.json
# En producción (Render): URL cruda de GitHub de la rama huérfana wrf-data
# WRF_JSON_URL=https://raw.githubusercontent.com/<TU_USUARIO>/<TU_REPO>/wrf-data/wrf_latest.json

# ------------------------------------------------------------------------------
# 3. SEGURIDAD, CORS Y AUTENTICACIÓN
# ------------------------------------------------------------------------------
# Clave secreta enviada en el header X-CRON-SECRET para POST /api/alerts/check
CRON_SECRET=climarc-secret-cron-key-change-me

# PIN opcional para proteger cambios de configuración en la UI (/configuracion)
# Si se deja vacío, no solicita PIN
ADMIN_PIN=1234

# Orígenes permitidos para CORS (separados por coma o lista JSON)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://climarc.vercel.app

# URL pública del frontend desplegado (se autoagrega a CORS y se usa en links de Telegram)
FRONTEND_URL=https://climarc.vercel.app

# Token opcional de SMN Argentina (si se usa en scripts locales para evitar bloqueos)
SMN_JWT_TOKEN=

# ------------------------------------------------------------------------------
# 4. TELEGRAM BOT Y ALERTAS PROACTIVAS (Solo Backend - NUNCA exponer en Frontend)
# ------------------------------------------------------------------------------
# Obtenido desde @BotFather en Telegram (ej: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=
# Chat ID numérico obtenido desde @userinfobot (ej: 987654321)
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 5. UMBRALES DE ALERTAS METEOROLÓGICAS (Sobrescriben defaults en SQLite/Render)
# ------------------------------------------------------------------------------
ALERT_RAIN_PROB_PCT=60.0
ALERT_RAIN_MM=1.5
ALERT_WRF_NEARBY_MM=8.0
ALERT_GUST_KMH=45.0
ALERT_TEMP_DROP_C=6.0
ALERT_COLD_APPARENT_C=5.0
ALERT_CAPE_JKG=1000.0
ALERT_COOLDOWN_HOURS=4.0
ALERT_QUIET_ENABLED=false
ALERT_QUIET_START_HOUR=23
ALERT_QUIET_END_HOUR=7

# ------------------------------------------------------------------------------
# 6. VARIABLES DE ENTORNO PARA EL FRONTEND (Vite / Vercel)
# ------------------------------------------------------------------------------
# En desarrollo local: dejar vacío "" para usar el proxy de Vite/Nginx a localhost:8000
# En Vercel: URL completa del backend desplegado en Render
# VITE_API_URL=https://climarc-api.onrender.com
VITE_API_URL=
